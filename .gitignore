# ── Data — kept local, don't commit ─────────────────────────────────────────
# data/objects           : phone videos of the test objects
# data/objaverse         : GraspGen's Objaverse meshes, scales, annotations, splits
# data/ycb               : YCB meshes, downloaded by stage2_grasp.ipynb
# data/gripper/*.stl     : gripper CAD meshes
# selected_objects       : Isaac Sim USD assets for graspgenx_selected_objects.py
# The gripper's small config files stay tracked: the notebooks, the scripts and
# the GraspGenX setup below read them directly.
data/*
!data/gripper/
data/gripper/*
!data/gripper/*.json
!data/gripper/*.md
!data/gripper/*.patch
selected_objects/
robobrain_dataset_summary.csv
*.npz
*.npy
*.pkl
*.h5

# ── Videos ──────────────────────────────────────────────────────────────────
*.mov
*.MOV
*.mp4
*.MP4
*.avi
*.mkv
*.webm

# ── GraspGenX upstream clone (~3.6 GB with checkpoints, has its own .git) ───
#   git clone https://github.com/NVlabs/GraspGenX.git
#   cd GraspGenX && git apply ../data/gripper/graspgenx-mac-device.patch
#   pip install -e .      # checkpoints auto-download on first import
GraspGenX/

# ── LoRA adapters (~100 MB) — retrain with finetune_selector.ipynb ──────────
*.safetensors

# ── Python / scratch ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store
*.log
